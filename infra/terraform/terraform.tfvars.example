# Copie para terraform.tfvars e ajuste. O arquivo real é gitignorado.
#
#   cp terraform.tfvars.example terraform.tfvars

# cluster_name = "autopecas"
# node_image   = "kindest/node:v1.31.0"
# worker_count = 2

# Portas do host. Altere se 8080 ou 9080 já estiverem ocupadas na sua máquina.
# app_host_port      = 8080
# keycloak_host_port = 9080

# postgres_storage = "2Gi"

# NÃO coloque a senha aqui em ambiente compartilhado. Prefira:
#   export TF_VAR_postgres_password='...'
# Em qualquer caso, o valor acaba em texto claro no arquivo de state.
# postgres_password = "postgres"

# Desligue apenas se o cluster já tiver um metrics-server. Sem ele o HPA
# não coleta métricas e fica em <unknown>.
# install_metrics_server = true
